# A filled-in secrets file must never be committed. ESP32/SnapRiddle_HW/SECRETS.h
# is tracked as an empty template; keep your real copy outside the repo or use
# `git update-index --skip-worktree ESP32/SnapRiddle_HW/SECRETS.h` before editing it.
*.secrets.h
